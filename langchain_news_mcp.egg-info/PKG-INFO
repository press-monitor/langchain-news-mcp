### Global News Monitoring

```python
from langchain_news_mcp import NewsTool

# Multi-language news tool
global_news_tool = NewsTool(server_url="http://localhost:3000")

# Monitor global sentiment
def monitor_global_sentiment(topic: str):
    """Monitor sentiment across different regions and languages."""
    regions = [
        {"country_code": "US", "lang_code": "en", "region": "North America"},
        {"country_code": "GB,DE,FR", "lang_code": "en", "region": "Europe"},
        {"country_code": "JP,KR", "lang_code": "en", "region": "Asia"},
        {"country_code": "BR", "lang_code": "pt", "region": "South America"},
        {"country_code": "IN", "lang_code": "en", "region": "India"}
    ]

    global_sentiment = {}

    for region_config in regions:
        result = global_news_tool.run({
            "query": topic,
            "country_code": region_config["country_code"],
            "lang_code": region_config["lang_code"],
            "count": 20
        })

        # Analyze sentiment (you would implement sentiment analysis here)
        sentiment_score = analyze_sentiment(result)
        global_sentiment[region_config["region"]] = sentiment_score

    return global_sentiment

# Usage
sentiment = monitor_global_sentiment("renewable energy")
print(sentiment)
```

### Translation Support

```python
from langchain_news_mcp import NewsTool

# Use translated headlines for multilingual analysis
news_tool = NewsTool(server_url="http://localhost:3000")

def get_translated_news(query: str, target_language: str = "en"):
    """Get news translated to target language."""
    result = news_tool.run({
        "query": query,
        "news_type": "headlines_translated",
        "target_lang_code": target_language,
        "count": 20
    })
    return result

# Get Chinese news translated to English
translated_news = get_translated_news("人工智能", "en")
