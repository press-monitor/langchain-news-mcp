## 🤖 Agent Examples

### Research Assistant Agent

```python
from langchain.agents import initialize_agent, AgentType
from langchain.llms import OpenAI
from langchain.memory import ConversationBufferMemory
from langchain_news_mcp import NewsTool, NewsRetriever

# Create tools
news_tool = NewsTool(server_url="http://localhost:3000")
news_retriever = NewsRetriever(server_url="http://localhost:3000")

# Create memory for conversation
memory = ConversationBufferMemory(
    memory_key="chat_history",
    return_messages=True
)

# Create research agent
research_agent = initialize_agent(
    tools=[news_tool],
    llm=OpenAI(temperature=0.1),
    agent=AgentType.CONVERSATIONAL_REACT_DESCRIPTION,
    memory=memory,
    verbose=True
)

# Research session
questions = [
    "What are the latest developments in quantum computing?",
    "How are these developments affecting the tech industry?",
    "What companies are leading in this space?",
    "What are the potential applications?"
]

for question in questions:
    response = research_agent.run(question)
    print(f"Q: {question}")
    print(f"A: {response}\n")
```

### News Monitoring Agent

```python
import asyncio
from datetime import datetime, timedelta
from langchain_news_mcp import NewsTool

class NewsMonitoringAgent:
    def __init__(self, server_url: str, api_key: str = None):
        self.news_tool = NewsTool(
            server_url=server_url,
            api_key=api_key
        )
        self.monitored_topics = []
        self.alerts = []

    def add_topic(self, topic: str, filters: dict = None):
        """Add a topic to monitor."""
        self.monitored_topics.append({
            "topic": topic,
            "filters": filters or {},
            "last_check": datetime.utcnow()
        })

    async def check_updates(self):
        """Check for new articles on monitored topics."""
        for topic_config in self.monitored_topics:
            topic = topic_config["topic"]
            filters = topic_config["filters"]

            # Search for recent news
            result = self.news_tool.run({
                "query": topic,
                "sort": "latest",
                "count": 10,
                **filters
            })

            # Process results and create alerts
            if "Found" in result:
                self.alerts.append({
                    "topic": topic,
                    "timestamp": datetime.utcnow(),
                    "content": result
                })

    async def run_monitoring(self, interval: int = 300):
        """Run continuous monitoring."""
        while True:
            await self.check_updates()
            await asyncio.sleep(interval)

# Usage
monitor = NewsMonitoringAgent("http://localhost:3000")
monitor.add_topic("AAPL stock", {"country_code": "US"})
monitor.add_topic("climate change", {"lang_code": "en"})

# Run monitoring
asyncio.run(monitor.run_monitoring())
```

### Content Generation Agent

```python
from langchain.agents import initialize_agent
from langchain.llms import OpenAI
from langchain.prompts import PromptTemplate
from langchain_news_mcp import NewsTool

# Create content generation prompt
content_prompt = PromptTemplate(
    input_variables=["topic", "news_data"],
    template="""
    Based on the following recent news about {topic}:

    {news_data}

    Write a comprehensive blog post that:
    1. Summarizes the key developments
    2. Analyzes the implications
    3. Provides expert commentary
    4. Includes relevant quotes and sources

    Blog Post:
    """
)

# Create content agent
news_tool = NewsTool(server_url="http://localhost:3000")
content_agent = initialize_agent(
    tools=[news_tool],
    llm=OpenAI(temperature=0.7),
    agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION
)

def generate_blog_post(topic: str) -> str:
    """Generate a blog post on a given topic using current news."""
    # Get recent news
    news_result = news_tool.run({
        "query": topic,
        "news_type": "briefs",
        "count": 15,
        "sort": "relevance"
    })

    # Generate content
    blog_post = content_prompt.format(
        topic=topic,
        news_data=news_result
    )

    return blog_post

# Usage
post = generate_blog_post("sustainable energy innovations")
print(post)
```

