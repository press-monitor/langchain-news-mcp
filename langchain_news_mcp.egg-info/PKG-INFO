## 📊 Performance Optimization

### Caching Strategy

```python
from functools import lru_cache
from langchain_news_mcp import NewsTool

class CachedNewsTool(NewsTool):
    def __init__(self, *args, cache_size=128, **kwargs):
        super().__init__(*args, **kwargs)
        self.cache_size = cache_size
        self._cached_run = lru_cache(maxsize=cache_size)(self._run_uncached)

    def _run_uncached(self, query_hash: str, **params):
        """Uncached version of run."""
        return super()._run(**params)

    def _run(self, **params):
        """Run with caching."""
        # Create cache key from parameters
        query_hash = hash(frozenset(params.items()))
        return self._cached_run(query_hash, **params)

# Usage
cached_tool = CachedNewsTool(
    server_url="http://localhost:3000",
    cache_size=256
)
```

### Batch Processing

```python
import asyncio
from langchain_news_mcp import NewsTool

async def batch_news_search(queries: list, server_url: str):
    """Process multiple news queries in parallel."""
    news_tool = NewsTool(server_url=server_url)

    # Create tasks for parallel execution
    tasks = [
        news_tool._arun(**query) for query in queries
    ]

    # Execute all queries concurrently
    results = await asyncio.gather(*tasks, return_exceptions=True)

    # Process results
    processed_results = []
    for i, result in enumerate(results):
        if isinstance(result, Exception):
            processed_results.append({
                "query": queries[i],
                "error": str(result),
                "success": False
            })
        else:
            processed_results.append({
                "query": queries[i],
                "result": result,
                "success": True
            })

    return processed_results

# Usage
queries = [
    {"query": "artificial intelligence", "count": 10},
    {"query": "renewable energy", "count": 10},
    {"query": "space exploration", "count": 10}
]

results = asyncio.run(batch_news_search(queries, "http://localhost:3000"))
```

