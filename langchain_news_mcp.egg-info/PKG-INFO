custom_tool.description = """
Use this tool to search for recent news articles.
Provide a clear search query and specify:
- news_type: 'headlines' for quick updates, 'briefs' for summaries, 'fulltext' for complete articles
- country_code: ISO country codes like 'US', 'UK', 'DE' (optional)
- count: number of results needed (1-100)
- sort: 'latest' for newest first, 'relevance' for most relevant
"""
```

### Retry Configuration

```python
from langchain_news_mcp import NewsTool
import asyncio

# Tool with retry logic
class ResilientNewsTool(NewsTool):
    def __init__(self, *args, max_retries=3, **kwargs):
        super().__init__(*args, **kwargs)
        self.max_retries = max_retries

    async def _arun(self, *args, **kwargs):
        """Run with retry logic."""
        for attempt in range(self.max_retries):
            try:
                return await super()._arun(*args, **kwargs)
            except Exception as e:
                if attempt == self.max_retries - 1:
                    raise e
                await asyncio.sleep(2 ** attempt)  # Exponential backoff

# Usage
resilient_tool = ResilientNewsTool(
    server_url="http://localhost:3000",
    max_retries=3
)
```

