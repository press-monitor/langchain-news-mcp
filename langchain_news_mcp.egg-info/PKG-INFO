## 📊 Advanced Use Cases

### Market Intelligence Agent

```python
from langchain.agents import initialize_agent
from langchain.llms import OpenAI
from langchain_news_mcp import NewsTool, NewsRetriever
import json

class MarketIntelligenceAgent:
    def __init__(self, server_url: str):
        self.news_tool = NewsTool(server_url=server_url)
        self.retriever = NewsRetriever(server_url=server_url)

        # Create specialized agent
        self.agent = initialize_agent(
            tools=[self.news_tool],
            llm=OpenAI(temperature=0.1),
            agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION
        )

    def analyze_company(self, company: str, ticker: str = None):
        """Comprehensive company analysis using news data."""
        queries = [
            f"{company} earnings revenue",
            f"{company} partnership acquisition",
            f"{company} product launch innovation",
            f"{company} leadership management"
        ]

        if ticker:
            queries.append(f"{ticker} stock price analysis")

        analysis = {}
        for query in queries:
            result = self.agent.run(f"Analyze recent news about: {query}")
            analysis[query] = result

        return analysis

    def sector_analysis(self, sector: str):
        """Analyze an entire industry sector."""
        sector_queries = [
            f"{sector} industry trends",
            f"{sector} market growth",
            f"{sector} regulatory changes",
            f"{sector} competitive landscape"
        ]

        sector_intel = {}
        for query in sector_queries:
            result = self.agent.run(f"Provide analysis on: {query}")
            sector_intel[query] = result

        return sector_intel

# Usage
intel_agent = MarketIntelligenceAgent("http://localhost:3000")

# Company analysis
apple_analysis = intel_agent.analyze_company("Apple", "AAPL")

# Sector analysis
ai_sector = intel_agent.sector_analysis("artificial intelligence")
```

### Compliance Monitoring Agent

```python
from langchain_news_mcp import NewsTool
from datetime import datetime, timedelta
import re

class ComplianceMonitoringAgent:
    def __init__(self, server_url: str):
        self.news_tool = NewsTool(server_url=server_url)
        self.compliance_keywords = [
            "SEC filing", "regulatory approval", "FDA approval",
            "antitrust", "investigation", "violation",
            "compliance", "audit", "penalty", "fine"
        ]

    def monitor_regulatory_changes(self, industry: str):
        """Monitor regulatory changes for specific industry."""
        regulatory_news = []

        for keyword in self.compliance_keywords:
            query = f"{industry} {keyword}"
            result = self.news_tool.run({
                "query": query,
                "news_type": "fulltext",
                "count": 10,
                "sort": "latest"
            })

            # Extract compliance-relevant information
            if self._is_compliance_relevant(result):
                regulatory_news.append({
                    "keyword": keyword,
                    "news": result,
                    "timestamp": datetime.utcnow(),
                    "urgency": self._assess_urgency(result)
                })

        return regulatory_news

    def _is_compliance_relevant(self, news_text: str) -> bool:
        """Determine if news is compliance-relevant."""
        compliance_indicators = [
            "regulatory", "compliance", "violation",
            "investigation", "penalty", "SEC", "FDA"
        ]
        return any(indicator.lower() in news_text.lower()
                  for indicator in compliance_indicators)

    def _assess_urgency(self, news_text: str) -> str:
        """Assess urgency level of compliance news."""
        high_urgency = ["violation", "investigation", "penalty", "fine"]
        medium_urgency = ["regulatory change", "new regulation"]

        if any(term.lower() in news_text.lower() for term in high_urgency):
            return "HIGH"
        elif any(term.lower() in news_text.lower() for term in medium_urgency):
            return "MEDIUM"
        else:
            return "LOW"

# Usage
compliance_agent = ComplianceMonitoringAgent("http://localhost:3000")
pharma_compliance = compliance_agent.monitor_regulatory_changes("pharmaceutical")
```

