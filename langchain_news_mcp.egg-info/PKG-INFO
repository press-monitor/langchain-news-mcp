from langchain_news_mcp import NewsTool

# Create custom tool with specific defaults
custom_tool = NewsTool(
    server_url="http://localhost:3000",
    api_key="your_api_key",
    timeout=45.0,
    default_count=25,
    default_sort="relevance",
    default_news_type="briefs",
