## 🧪 Testing

### Unit Tests

```python
import pytest
from unittest.mock import Mock, patch
from langchain_news_mcp import NewsTool

@pytest.fixture
def mock_news_tool():
    return NewsTool(
        server_url="http://test-server:3000",
        api_key="test_key"
    )

@patch('httpx.Client.post')
def test_news_tool_basic_search(mock_post, mock_news_tool):
    # Mock response
    mock_response = Mock()
    mock_response.json.return_value = {
        "result": {
            "items": [
                {
                    "id": "1",
                    "title": "Test Article",
                    "source": "Test Source",
                    "url": "http://test.com"
                }
            ]
        }
    }
    mock_response.raise_for_status.return_value = None
    mock_post.return_value = mock_response

    # Test the tool
    result = mock_news_tool.run({
        "query": "test query",
        "count": 1
    })

    assert "Test Article" in result
    assert "Test Source" in result

@patch('httpx.AsyncClient.post')
@pytest.mark.asyncio
async def test_news_tool_async(mock_post, mock_news_tool):
    # Mock async response
    mock_response = Mock()
    mock_response.json.return_value = {
        "result": {"items": [{"title": "Async Test"}]}
    }
    mock_response.raise_for_status.return_value = None
    mock_post.return_value = mock_response

    # Test async method
    result = await mock_news_tool._arun(
        query="async test",
        count=1
    )

    assert "Async Test" in result
```

### Integration Tests

```python
import pytest
from langchain.agents import initialize_agent, AgentType
from langchain.llms import FakeListLLM
from langchain_news_mcp import NewsTool

@pytest.mark.integration
def test_news_tool_with_agent():
    """Test news tool integration with LangChain agent."""
    # Use fake LLM for testing
    fake_llm = FakeListLLM(responses=[
        "I need to search for news about artificial intelligence",
        "Based on the news results, here's my analysis..."
    ])

    # Create news tool (you'll need a test server)
    news_tool = NewsTool(
        server_url="http://localhost:3000",
        api_key="test_key"
    )

    # Create agent
    agent = initialize_agent(
        tools=[news_tool],
        llm=fake_llm,
        agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION
    )

    # Test agent
    result = agent.run("Find news about AI")
    assert isinstance(result, str)
    assert len(result) > 0
```

