## 📚 Examples Repository

### Complete Application Examples

```python
# examples/news_research_assistant.py
from langchain.agents import initialize_agent
from langchain.memory import ConversationBufferMemory
from langchain.llms import OpenAI
from langchain_news_mcp import NewsTool, NewsRetriever

class NewsResearchAssistant:
    """Complete news research assistant using LangChain and News MCP."""

    def __init__(self, server_url: str, openai_api_key: str, news_api_key: str = None):
        # Initialize tools
        self.news_tool = NewsTool(
            server_url=server_url,
            api_key=news_api_key
        )

        self.news_retriever = NewsRetriever(
            server_url=server_url,
            api_key=news_api_key
        )

        # Initialize LLM
        self.llm = OpenAI(
            openai_api_key=openai_api_key,
            temperature=0.1
        )

        # Initialize memory
        self.memory = ConversationBufferMemory(
            memory_key="chat_history",
            return_messages=True
        )

        # Create agent
        self.agent = initialize_agent(
            tools=[self.news_tool],
            llm=self.llm,
            agent=AgentType.CONVERSATIONAL_REACT_DESCRIPTION,
            memory=self.memory,
            verbose=True
        )

    def research_topic(self, topic: str, depth: str = "summary") -> str:
        """Research a topic with specified depth."""
        if depth == "summary":
            prompt = f"Provide a brief summary of recent news about {topic}"
        elif depth == "detailed":
            prompt = f"Provide a detailed analysis of recent news about {topic}, including key developments, implications, and expert opinions"
        elif depth == "comprehensive":
            prompt = f"Provide a comprehensive research report on {topic} based on recent news, including timeline, stakeholder analysis, market impact, and future outlook"

        return self.agent.run(prompt)

    def compare_topics(self, topic1: str, topic2: str) -> str:
        """Compare two topics based on recent news."""
        prompt = f"Compare recent news coverage of {topic1} versus {topic2}. Analyze similarities, differences, and relative importance."
        return self.agent.run(prompt)

    def trend_analysis(self, topic: str, timeframe: str = "recent") -> str:
        """Analyze trends for a topic."""
        prompt = f"Analyze trends in news coverage about {topic} over the {timeframe} period. Identify patterns, sentiment changes, and emerging themes."
        return self.agent.run(prompt)

# Usage
assistant = NewsResearchAssistant(
    server_url="http://localhost:3000",
    openai_api_key="your_openai_key",
    news_api_key="your_news_key"
)

# Research examples
ai_summary = assistant.research_topic("artificial intelligence", "summary")
climate_detailed = assistant.research_topic("climate change", "detailed")
comparison = assistant.compare_topics("renewable energy", "fossil fuels")
```

